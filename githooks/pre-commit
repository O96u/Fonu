#!/bin/sh
# Reject commits authored or committed by Cursor Agent identities.

set -eu

is_forbidden_identity() {
	name="${1:-}"
	email="${2:-}"

	name_lower=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
	email_lower=$(printf '%s' "$email" | tr '[:upper:]' '[:lower:]')

	case "$name_lower" in
	*cursoragent* | *"cursor agent"*) return 0 ;;
	esac

	case "$email_lower" in
	*cursoragent* | *"cursor agent"*) return 0 ;;
	esac

	if [ "$name_lower" = "cursor" ]; then
		return 0
	fi

	return 1
}

check_pair() {
	label="$1"
	name="$2"
	email="$3"

	if is_forbidden_identity "$name" "$email"; then
		printf 'Error: %s identity is not allowed in this repository.\n' "$label" >&2
		printf '  name:  %s\n' "$name" >&2
		printf '  email: %s\n' "$email" >&2
		printf '\nForbidden patterns: cursoragent, "cursor agent", or name "Cursor".\n' >&2
		printf 'Configure your own Git identity, then retry:\n' >&2
		printf '  git config user.name "Your Name"\n' >&2
		printf '  git config user.email "you@example.com"\n' >&2
		exit 1
	fi
}

config_name=$(git config --get user.name 2>/dev/null || true)
config_email=$(git config --get user.email 2>/dev/null || true)
check_pair "git config" "$config_name" "$config_email"

author_name="${GIT_AUTHOR_NAME:-$config_name}"
author_email="${GIT_AUTHOR_EMAIL:-$config_email}"
committer_name="${GIT_COMMITTER_NAME:-$config_name}"
committer_email="${GIT_COMMITTER_EMAIL:-$config_email}"

check_pair "author" "$author_name" "$author_email"
check_pair "committer" "$committer_name" "$committer_email"

# commit-msg hook performs message checks when installed via core.hooksPath.

exit 0
