#!/bin/bash
set -euo pipefail

APP_BIN="${TRIM_APPDEST}/fonu"
PID_FILE="${TRIM_PKGVAR}/fonu.pid"
LOG_FILE="${TRIM_PKGVAR}/fonu.log"
ENV_FILE="${TRIM_PKGETC}/fonu.env"
NGINX_PID="${TRIM_PKGVAR}/nginx/nginx.pid"
FRPC_PID="${TRIM_PKGVAR}/frp/frpc.pid"
APP_ROOT="/var/apps/${TRIM_APPNAME:-fonu}"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"$LOG_FILE"
}

check_process() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

ensure_runtime_dirs() {
  mkdir -p \
    "${TRIM_PKGVAR}" \
    "${TRIM_PKGETC}" \
    "${TRIM_PKGVAR}/cache/client_temp" \
    "${TRIM_PKGVAR}/cache/proxy_temp" \
    "${TRIM_PKGVAR}/cache/fastcgi_temp" \
    "${TRIM_PKGVAR}/cache/uwsgi_temp" \
    "${TRIM_PKGVAR}/cache/scgi_temp" \
    "${TRIM_PKGVAR}/nginx" \
    "${TRIM_PKGVAR}/frp" \
    "${TRIM_PKGVAR}/logs" \
    "${TRIM_PKGVAR}/certs"
  mkdir -p "${APP_ROOT}/shares/etc/modules" 2>/dev/null || true
  mkdir -p "${APP_ROOT}/shares/fonu/etc" "${APP_ROOT}/shares/fonu/www" "${APP_ROOT}/shares/fonu/certs" 2>/dev/null || true
}

load_env() {
  ensure_runtime_dirs
  if [ -f "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    set -a
    source "$ENV_FILE"
    set +a
  fi

  if [ -z "${FONU_SESSION_SECRET:-}" ] || [ "${FONU_SESSION_SECRET}" = "change-me-in-production" ]; then
    if [ -f "${TRIM_PKGETC}/session_secret" ]; then
      FONU_SESSION_SECRET="$(cat "${TRIM_PKGETC}/session_secret")"
    else
      FONU_SESSION_SECRET="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
      printf '%s' "$FONU_SESSION_SECRET" >"${TRIM_PKGETC}/session_secret"
      chmod 600 "${TRIM_PKGETC}/session_secret"
    fi
  fi

  export FONU_DATA_DIR="${FONU_DATA_DIR:-${TRIM_PKGVAR}}"
  if [ -n "${FONU_ADMIN_PORT:-}" ]; then
    export FONU_LISTEN=":${FONU_ADMIN_PORT}"
  else
    export FONU_LISTEN="${FONU_LISTEN:-:6893}"
  fi
  export FONU_NGINX_BIN="${FONU_NGINX_BIN:-${TRIM_APPDEST}/Nginx}"
  export FONU_FRPC_BIN="${FONU_FRPC_BIN:-${TRIM_APPDEST}/frpc}"
  if [ -n "${FONU_NGINX_MIME_TYPES:-}" ] && [ ! -f "${FONU_NGINX_MIME_TYPES}" ]; then
    unset FONU_NGINX_MIME_TYPES
  fi
  export FONU_NGINX_MIME_TYPES="${FONU_NGINX_MIME_TYPES:-${TRIM_APPDEST}/mime.types}"
  export FONU_NGINX_PID="${FONU_NGINX_PID:-${TRIM_PKGVAR}/nginx/nginx.pid}"
  export FONU_MIGRATIONS_DIR="${FONU_MIGRATIONS_DIR:-${TRIM_APPDEST}/migrations}"
  export FONU_NGINX_HTTP_PORT="${FONU_NGINX_HTTP_PORT:-18080}"
  export FONU_NGINX_HTTPS_PORT="${FONU_NGINX_HTTPS_PORT:-9443}"
  export FONU_SESSION_SECRET
  export TRIM_DATA_SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}"
  export TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}"
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

stop_child_pidfile() {
  local file="$1"
  local name="$2"
  if [ ! -f "$file" ]; then
    return 0
  fi
  local pid
  pid="$(head -n 1 "$file" | tr -d '[:space:]')"
  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "$file"
    return 0
  fi
  log_msg "Stopping ${name} (pid ${pid})..."
  kill -TERM "$pid" 2>>"$LOG_FILE" || true
  local count=0
  while check_process "$pid" && [ "$count" -lt 15 ]; do
    sleep 1
    count=$((count + 1))
  done
  if check_process "$pid"; then
    kill -KILL "$pid" 2>>"$LOG_FILE" || true
  fi
  rm -f "$file"
}

start_app() {
  if status_app; then
    return 0
  fi

  if [ ! -x "$APP_BIN" ]; then
    echo "fonu binary missing: $APP_BIN" >"${TRIM_TEMP_LOGFILE:-/tmp/fonu-start.log}"
    exit 1
  fi

  load_env
  log_msg "Starting Fonu..."
  cd "${TRIM_APPDEST}"
  nohup "$APP_BIN" >>"$LOG_FILE" 2>&1 &
  echo "$!" >"$PID_FILE"
  admin_port="${FONU_ADMIN_PORT:-6893}"
  ready=0
  count=0
  while [ "$count" -lt 40 ]; do
    if ! status_app; then
      log_msg "Fonu failed to start; see ${LOG_FILE}"
      exit 1
    fi
    if (echo >/dev/tcp/127.0.0.1/"${admin_port}") >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.25
    count=$((count + 1))
  done
  if [ "$ready" -ne 1 ]; then
    log_msg "Fonu process is up but :${admin_port} not accepting connections yet"
  fi
}

stop_app() {
  log_msg "Stopping Fonu..."
  if status_app; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    kill -TERM "$pid" 2>>"$LOG_FILE" || true
    local count=0
    while check_process "$pid" && [ "$count" -lt 20 ]; do
      sleep 1
      count=$((count + 1))
    done
    if check_process "$pid"; then
      kill -KILL "$pid" 2>>"$LOG_FILE" || true
    fi
    rm -f "$PID_FILE"
  fi
  stop_child_pidfile "$NGINX_PID" "nginx"
  stop_child_pidfile "${TRIM_PKGVAR}/nginx/nginx.pid" "nginx"
  stop_child_pidfile "$FRPC_PID" "frpc"
}

case "${1:-}" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: ${1:-}" >"${TRIM_TEMP_LOGFILE:-/tmp/fonu-cmd.log}"
    exit 1
    ;;
esac
